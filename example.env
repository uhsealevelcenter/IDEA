OPENAI_API_KEY=$YOUR_API_KEY_HERE
# Azure AI Foundry OpenAI-compatible endpoint (used by langgraph/ agents and tools).
# e.g. https://<your-resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=$YOUR_AZURE_OPENAI_ENDPOINT_HERE
#JETSTREAM2_API_Key=$YOUR_OTHER_API_KEY_HERE # Example: Jetstream2 (ACCESS) API Key
# PQA_HOME=/app/data
# PAPER_DIRECTORY=/app/data/papers
# PaperQA answer, summary, and agent roles all use this LiteLLM alias.
PQA_LLM_MODEL=gpt-5.6-terra
PQA_EMBEDDING_MODEL=text-embedding-3-small
PQA_LITELLM_BASE_URL=http://litellm:8080/v1
PQA_SYNC_TIMEOUT_SECONDS=300

# Allow complex IDEA model calls up to three minutes and retry one timeout that
# occurred before any response chunks were streamed.
# Primary IDEA conversation model. Auxiliary tools remain on IDEA_TOOL_MODEL.
IDEA_AGENT_MODEL=gpt-5.6-terra
IDEA_TOOL_MODEL=gpt-5.6-terra
IDEA_MODEL_REQUEST_TIMEOUT_SECONDS=180
IDEA_MODEL_MAX_RETRIES=1
# Optional Codex coding-agent delegation. When the dedicated overrides below
# are blank, the current developer-stage deployment reuses OPENAI_BASE_URL and
# OPENAI_API_KEY. Codex is enabled by default; set this false only for an
# explicit rollback. Delegation remains unavailable unless the rebuilt guest
# image is deployed and the endpoint is reachable from inside a microVM.
# TODO(low priority): replace that fallback with a guest-reachable LiteLLM
# route and a separate revocable, model-restricted, low-budget virtual key.
# Never use LITELLM_MASTER_KEY or the primary IDEA shared virtual key.
IDEA_CODEX_ENABLED=true
IDEA_CODEX_MODEL=gpt-5.6-terra
IDEA_CODEX_BASE_URL=
IDEA_CODEX_API_KEY=
IDEA_CODEX_MAX_EVENTS=100
PQA_MAX_PDF_BYTES=1073741824

# NASA Earthdata Login
# EARTHDATA_USERNAME=$YOUR_EARTHDATA_USERNAME
# EARTHDATA_PASSWORD=$YOUR_EARTHDATA_PASSWORD


# Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=idea_db
POSTGRES_USER=idea_user
POSTGRES_PASSWORD=idea_password_changethis

# Dedicated least-privilege LangGraph checkpoint role. Initialize once with:
#   ./langgraph/db/setup_langgraph_db.sh
LANGGRAPH_DB_PASSWORD=$YOUR_LANGGRAPH_DB_PASSWORD_HERE
# Raw 16-, 24-, or 32-character AES key used to encrypt persisted checkpoints.
# Generate a 32-character value, for example: openssl rand -base64 24
LANGGRAPH_AES_KEY=
IDEA_IDENTITY_SECRET=
IDEA_AGENT_RUNTIME=langgraph
IDEA_KERNEL_SCOPE=chat_assistant
# Bound durable execution ledgers and the execution-memory excerpt added to
# each model request. Message-to-checkpoint branch mappings expire after one
# year unless refreshed by use.
IDEA_MAX_STATE_BYTES=524288
IDEA_MAX_RECENT_ACTIONS=50
IDEA_MAX_RECENT_EXECUTIONS=20
IDEA_MAX_CODE_INLINE_BYTES=100000
IDEA_MAX_EXECUTION_MEMORY_BYTES=48000
# Every within-turn tool observation and each prior assistant display message
# is compacted to these byte ceilings before the model sees it. Repeated exact
# tool calls are blocked after the configured number of completed attempts.
IDEA_MAX_MODEL_TOOL_OBSERVATION_BYTES=6000
IDEA_MAX_MODEL_HISTORY_MESSAGE_BYTES=16000
IDEA_MAX_IDENTICAL_TOOL_CALLS=3
IDEA_CHECKPOINT_MAP_TTL_SECONDS=31536000

# Application Configuration
# SECRET_KEY=changethis_secret_key_in_production
# FIRST_SUPERUSER=admin@idea.com
# FIRST_SUPERUSER_PASSWORD=changethis
# Password recovery email configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="IDEA <idea-dev-grp@hawaii.edu>"
# SMTP_USE_TLS=1
# FRONTEND_BASE_URL=http://localhost # but in production https://uhslc.soest.hawaii.edu
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# # How long a guest account remains usable before access expires
# GUEST_SESSION_TIMEOUT_MINUTES=60
# # How often the background worker checks for expired guest accounts and cleans them up
# GUEST_EXPIRY_CHECK_INTERVAL_SECONDS=60

# CORS Origins Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost,https://uhslc.soest.hawaii.edu/research/IDEA

# API Host Configuration (used for custom instructions and API responses)
# API_HOST=https://nemo-dev.tuns.sh # or http://localhost

# ==== Open WebUI (see openwebui/functions/idea_pipe.py) ====
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=changethis_webui_secret_key
ENABLE_SIGNUP=true
# Optional admin API key used by Open WebUI deployment/configuration scripts.
# Output syncing does not use this shared key: the Pipe forwards the current
# user's authenticated session so generated files have the correct owner.
OPENWEBUI_API_KEY=
# Deadline and per-file byte limit for copying user attachments into their
# private sandbox before an IDEA Agent run begins.
INPUT_SYNC_TIMEOUT_SECONDS=120
INPUT_SYNC_MAX_FILE_BYTES=1073741824
# Limits for sending synchronized PNG/JPEG/GIF/WebP attachments to model
# vision. Files remain available in the sandbox even when over these limits.
VISION_MAX_IMAGE_BYTES=20971520
VISION_MAX_IMAGES_PER_TURN=8
OUTPUT_SYNC_TIMEOUT_SECONDS=30
OUTPUT_SYNC_MAX_WORKERS=4
MAX_SKILL_BYTES=100000
# Hierarchical built-in packages validate each root/component independently,
# then enforce an aggregate all-or-nothing bundle limit.
MAX_SKILL_COMPONENT_BYTES=100000
MAX_SKILL_BUNDLE_BYTES=200000
MAX_SKILL_COMPONENTS=32
MAX_SKILL_DEPENDENCY_DEPTH=16

# Open WebUI uses this hidden LiteLLM model for auxiliary work such as chat
# titles, tags, follow-up suggestions, and search queries. The deployment
# configurator persists this setting through Open WebUI's admin API while
# leaving all other Admin Panel settings editable:
#   ./openwebui/configure_openwebui.py
TASK_MODEL_EXTERNAL=gpt-5.6-luna
# IDEA supplies its own persistent, identity-scoped LangGraph Python kernel.
# Disable Open WebUI's unrelated browser/Jupyter code-block runner and native
# Code Interpreter so users are not offered execution in the wrong runtime.
# The deployment configurator also persists these values through the admin API.
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
# Match legacy IDEA's production policy: compact at 50% of its 272,000-token
# long-context threshold. The configurator persists these two values through
# Open WebUI's admin API.
ENABLE_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=136000
# Address Open WebUI uses to reach LiteLLM on the Compose network. This is
# intentionally distinct from OPENWEBUI_BASE_URL, which is the address
# langgraph/deployment scripts use to reach Open WebUI.
OPENWEBUI_LITELLM_BASE_URL=http://litellm:8080/v1

# Shared secret between langgraph_service.py, sandbox_service, and
# openwebui/functions/idea_pipe.py - guards the internal HTTP APIs between
# these services (langgraph <-> sandbox, and the Pipe function -> langgraph)
# now that those APIs have no other authentication of their own. Generate
# with: openssl rand -hex 32
# After setting this, also paste the same value into idea_pipe.py's
# INTERNAL_SERVICE_TOKEN Valve (Admin Panel > Functions in Open WebUI) -
# Valves are configured through that UI, not read from this file directly.
# Leave blank only for local dev (fails open - see langgraph_service.py /
# sandbox_service/main.py's require_internal_token).
INTERNAL_SERVICE_TOKEN=

# Host path passed through to the sandbox service's /dev/kvm - see
# docker-compose.yml's `sandbox.devices`. Leave UNSET on hosts without real
# KVM (e.g. a Mac); defaults to /dev/null there, which is safe. Set to
# /dev/kvm only on hosts that actually have it (e.g. a Jetstream2 VM) to
# enable microsandbox's isolated microVM backend.
KVM_DEVICE_PATH=

# "auto" uses microsandbox when KVM is functional and otherwise falls back to
# the limited local-shell backend. Production hosts should normally keep auto;
# use "microsandbox" when failure to boot isolated microVMs must fail closed.
SANDBOX_BACKEND=auto

# OCI image booted for each new microsandbox VM - see
# sandbox_service/msb_sandbox.py and interpreter_kernel/README.md. Defaults
# (docker-compose.yml) to ghcr.io/uhsealevelcenter/idea-oi-kernel:slim,
# which gives sandboxes a persistent Python kernel (run_python_tool) and
# Open Terminal-backed grep_search_tool/glob_search_tool. Leave unset to
# use that default, or set to "python" to fall back to the bare image
# (only run_terminal_tool/write_file_tool).
SANDBOX_IMAGE=

# Persistent-Python recovery policy. Stop first sends a normal interrupt,
# preserving kernel variables when Python responds. If the run remains stuck,
# IDEA replaces only that kernel after this grace period; if the guest control
# process is also wedged, it stop/resumes the same sandbox so files survive.
# Set the execution timeout to 0 to disable automatic recovery of a run that
# exceeds the hard ceiling. Recovery status records are retained only for
# diagnostics and expire after the final interval below.
SANDBOX_PYTHON_INTERRUPT_GRACE_SECONDS=7
SANDBOX_PYTHON_KERNEL_RECOVERY_GRACE_SECONDS=5
SANDBOX_PYTHON_EXECUTION_TIMEOUT_SECONDS=1800
SANDBOX_PYTHON_RUN_STATUS_TTL_SECONDS=3600

# Shared scientific datasets are maintained in the `idea_shared_data`
# Docker volume and exposed read-only at /app/data in every user sandbox.
# See shared_data/README.md. The container-internal mount path is fixed by
# docker-compose.yml and normally does not require an environment setting.

# Only needed if the ghcr.io package above is private - GitHub username +
# a Personal Access Token (classic, read:packages scope) so `msb`
# (microsandbox, running inside the sandbox container) can pull it. This is
# NOT the same as a `docker login` on the host - see interpreter_kernel/
# README.md's "Private registry auth" section for why and how
# sandbox_service/entrypoint.sh uses these. Leave both blank if the
# package is public.
GHCR_USERNAME=
GHCR_PAT=

# ==== LiteLLM proxy (see litellm/) ====
# Dedicated Postgres role, scoped to its own `litellm` schema on the
# existing `db` service's idea_db database - kept separate from
# POSTGRES_USER/idea_user so the proxy's Prisma migrations can never touch
# the main app's tables. Owns every object in the `litellm` schema; has no
# privileges anywhere else. LITELLM_DATABASE_URL itself is assembled from
# this in docker-compose.yml (env_file values are NOT variable-expanded,
# so it can't just be interpolated here).
# Generate with: openssl rand -hex 20
LITELLM_DB_PASSWORD=$YOUR_LITELLM_DB_PASSWORD_HERE

# Master key for the LiteLLM proxy's own admin/virtual-key auth (distinct
# from INTERNAL_SERVICE_TOKEN above, which guards langgraph<->sandbox).
# Generate with: printf 'sk-'; openssl rand -hex 32
LITELLM_MASTER_KEY=$YOUR_LITELLM_MASTER_KEY_HERE

# A single virtual key shared by every langgraph/ user (see
# agents/terminal_agent.py) - $100 total budget across all users combined.
# Per-user attribution/tracking is done separately via the
# x-litellm-end-user-id header (the user's email), not via separate keys.
# Generate once the litellm service is up and LITELLM_MASTER_KEY above is
# set:
#   curl -X POST http://localhost:8030/key/generate \
#     -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"max_budget": 100, "models": ["gpt-5.6-terra", "gpt-5.6-sol", "gpt-5.6-luna", "text-embedding-3-small"], "key_alias": "idea-langgraph-shared"}'
LITELLM_VIRTUAL_KEY=$YOUR_LITELLM_VIRTUAL_KEY_HERE
