# ==============================================================================
# Open WebUI Frontend Service Configuration
# ==============================================================================

# Session encryption secret key.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=your_secure_webui_secret_key_here

# Permit self-service account signups
ENABLE_SIGNUP=true

# Initial role for new accounts: 'pending' (requires admin approval) or 'user'
DEFAULT_USER_ROLE=pending

# Background external task model (title generation, etc.)
TASK_MODEL_EXTERNAL=gpt-5.6-luna

# Context compaction
ENABLE_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TOKEN_THRESHOLD=136000

# Upstream proxy connection
OPENWEBUI_LITELLM_BASE_URL=http://litellm:8080/v1

# Admin credentials for automated configuration scripts (register_idea_pipe.sh, configure_openwebui.py)
WEBUI_ADMIN_EMAIL=admin@idea.local
WEBUI_ADMIN_PASSWORD=your_admin_password_here

# Static API key for an Open WebUI admin account (Settings > Account > API Keys)
OPENWEBUI_API_KEY=
