# ==============================================================================
# LangGraph Agent Service Configuration
# ==============================================================================

# Primary conversational agent model
IDEA_AGENT_MODEL=gpt-5.6-terra
IDEA_AGENT_REASONING_EFFORT=medium
IDEA_TOOL_MODEL=gpt-5.6-terra

# Secondary advanced agent model (uses Responses API)
IDEA_ADVANCED_AGENT_MODEL=gpt-5.6-sol
IDEA_ADVANCED_REASONING_EFFORT=medium

# Model timeouts and retries
IDEA_MODEL_REQUEST_TIMEOUT_SECONDS=180
IDEA_MODEL_MAX_RETRIES=1

# Codex delegation settings
IDEA_CODEX_ENABLED=true
IDEA_CODEX_MODEL=gpt-5.6-terra
IDEA_CODEX_BASE_URL=
IDEA_CODEX_API_KEY=
IDEA_CODEX_MAX_EVENTS=100

# LangGraph PostgreSQL database password (role: idea_langgraph)
# Generate with: openssl rand -hex 20
LANGGRAPH_DB_PASSWORD=your_secure_langgraph_db_password_here

# AES-256 state encryption key for LangGraph checkpoints
# Generate with: openssl rand -hex 16
LANGGRAPH_AES_KEY=

# Identity hashing secret
IDEA_IDENTITY_SECRET=

# OpenAI / Azure AI Foundry credentials
OPENAI_API_KEY=your_openai_or_azure_api_key_here
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1

# Shared secret between langgraph_service, sandbox_service, and Open WebUI
INTERNAL_SERVICE_TOKEN=your_secure_internal_token_here

# OpenWebUI integration (for syncing outputs/files)
OPENWEBUI_BASE_URL=http://openwebui:8080
OPENWEBUI_API_KEY=

# PaperQA academic search and citation configuration
PQA_LLM_MODEL=gpt-5.6-luna
PQA_EMBEDDING_MODEL=text-embedding-3-small
PQA_LITELLM_BASE_URL=http://litellm:8080/v1
PQA_SYNC_TIMEOUT_SECONDS=300
PQA_MAX_PDF_BYTES=1073741824
SEMANTIC_SCHOLAR_API_KEY=
