# Build-time toggle for interpreter_kernel/Dockerfile: which dependency
# module (subfolder of modules/, each with its own requirements.txt) to bake
# into the guest image, so run_python_tool sessions can `import` those
# packages directly instead of installing them on demand mid-session via
# run_terminal_tool.
#
# Set to a module name under modules/ (currently: "original", mirrored from
# the repo root's pyproject.toml). Set to "none" to skip this layer entirely
# and fall back to the kernel's minimal baseline (interpreter_kernel/requirements.txt)
# plus on-demand pip installs.
ACTIVE_MODULE=original
