# Build-time toggle for interpreter_kernel/Dockerfile: which dependency
# module (subfolder of modules/, each with its own requirements.txt) to bake
# into the guest image, so run_python_tool sessions can `import` those
# packages directly instead of installing them on demand mid-session via
# run_terminal_tool.
#
# Set to a module under modules/ that contains requirements.lock. "research"
# is the curated production environment. "original" remains a historical
# snapshot of the legacy monolith and is intentionally not build-selectable
# until it is converted to a consistent lockfile.
ACTIVE_MODULE=research
