# ==============================================================================
# Langfuse Observability Service Configuration
# ==============================================================================

# Telemetry setting
TELEMETRY_ENABLED=false

# Dedicated Postgres password for the `langfuse` role and schema.
# Initialize once via ./langfuse/setup_langfuse_db.sh.
# Generate with: openssl rand -hex 20
LANGFUSE_DB_PASSWORD=your_secure_langfuse_db_password_here

# Database connection details
DATABASE_URL=postgresql://langfuse:your_secure_langfuse_db_password_here@db:5432/idea_db?schema=langfuse
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=idea_db

# NextAuth session secret, password-hash salt, and at-rest encryption key.
# Generate each with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Public URL the Langfuse UI reports itself as
NEXTAUTH_URL=http://localhost:3050

# Prevent unapproved signups on the Langfuse UI
AUTH_DISABLE_SIGNUP=true

# Optional one-shot bootstrap credentials to auto-create the project and API keys.
# Leave blank to create manually through the UI at http://localhost:3050.
LANGFUSE_INIT_ORG_ID=IDEA_admin
LANGFUSE_INIT_ORG_NAME=IDEA_admin
LANGFUSE_INIT_PROJECT_ID=Idea
LANGFUSE_INIT_PROJECT_NAME=Idea_proj
LANGFUSE_INIT_USER_EMAIL=admin@idea.local
LANGFUSE_INIT_USER_NAME="Idea Admin"
LANGFUSE_INIT_USER_PASSWORD=your_admin_password_here
LANGFUSE_INIT_PUBLIC_KEY=
LANGFUSE_INIT_SECRET_KEY=
