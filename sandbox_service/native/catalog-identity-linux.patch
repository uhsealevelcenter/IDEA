+// On Linux, closing a normal file descriptor would release this process's POSIX
+// locks on the database, including locks held by SQLite. An O_PATH descriptor
+// still pins and identifies the inode without taking part in those locks.
+#[cfg(target_os = "linux")]
+fn open_database_identity(path: &Path) -> std::io::Result<File> {
+    File::options().read(true).custom_flags(libc::O_PATH).open(path)
