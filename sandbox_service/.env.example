# ==============================================================================
# Sandbox Service Configuration
# ==============================================================================

# ==============================================================================
# Microsandbox KVM Compatibility Notice:
#
# Microsandbox (MicroVM isolation per user session) requires hardware-assisted
# virtualization via /dev/kvm on a Linux host (e.g. Jetstream2 VM, bare-metal Linux).
#
# IF RUNNING ON macOS, Windows (WSL2 without nested virtualization), or any
# cloud virtual machine WITHOUT hardware KVM acceleration:
#   - KVM_DEVICE_PATH must be left as /dev/null (or empty).
#   - SANDBOX_BACKEND should be set to 'auto' or 'local'.
#   - The service will automatically detect that KVM is not functional and
#     fall back safely to the local persistent terminal backend (one process per user).
#
# IF RUNNING ON a KVM-enabled Linux VM (e.g. Jetstream2):
#   - Set KVM_DEVICE_PATH=/dev/kvm
#   - Set SANDBOX_BACKEND=microsandbox (or 'auto')
# ==============================================================================
KVM_DEVICE_PATH=/dev/null

# Sandbox execution backend: 'auto' | 'microsandbox' | 'local'
SANDBOX_BACKEND=auto

# Per-microVM hardware limits (defaults: 1 vCPU, 1024MB RAM, 4096MB disk in dev;
# 2 vCPUs, 4096MB RAM, 10240MB disk in production).
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=1024
SANDBOX_DISK_MB=4096

# OCI guest image booted for each new microsandbox VM
SANDBOX_IMAGE=ghcr.io/uhsealevelcenter/idea-oi-kernel:slim

# GHCR credentials (only needed if the SANDBOX_IMAGE is private)
GHCR_USERNAME=
GHCR_PAT=

# Shared internal token guarding the sandbox HTTP API
INTERNAL_SERVICE_TOKEN=your_secure_internal_token_here

# Idle sandbox drain timeout in seconds
SANDBOX_IDLE_TIMEOUT_SECONDS=1800
