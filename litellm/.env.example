# ==============================================================================
# LiteLLM Proxy Service Configuration
# ==============================================================================

# Redis and Langfuse connection
REDIS_HOST=redis
REDIS_PORT=6379
LANGFUSE_HOST=http://langfuse:3000

# Database password for the dedicated `litellm` Postgres role and schema.
# Initialize once via ./litellm/setup_litellm_db.sh.
# Generate with: openssl rand -hex 20
LITELLM_DB_PASSWORD=your_secure_litellm_db_password_here
LITELLM_DATABASE_URL=postgresql://litellm:your_secure_litellm_db_password_here@db:5432/idea_db?schema=litellm

# Database connection details
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=idea_db

# Master admin key for LiteLLM administration and virtual key generation.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=your_secure_litellm_master_key_here

# Langfuse observability tracing keys (LiteLLM callback)
# Generated from the Langfuse UI at http://localhost:3050 (Project Settings > API Keys)
# or via the LANGFUSE_INIT_* bootstrap.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure OpenAI / OpenAI upstream credentials (forwarded to LiteLLM routes)
OPENAI_API_KEY=your_openai_or_azure_api_key_here
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
