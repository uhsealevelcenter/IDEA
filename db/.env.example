# ==============================================================================
# Database Service (PostgreSQL with pgvector) Configuration
# ==============================================================================

# Database storage directory inside container
PGDATA=/var/lib/postgresql/data/pgdata

# Superuser credentials for PostgreSQL
POSTGRES_USER=idea_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=idea_db

# Hostname and port used by other services on the internal docker network
POSTGRES_SERVER=db
POSTGRES_PORT=5432
