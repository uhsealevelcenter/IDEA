# ==============================================================================
# Nginx Reverse Proxy Configuration
# ==============================================================================

# HTTP host port (defaults to 80)
NGINX_PORT_HTTP=80

# HTTPS host port (set to 443:443 in production with TLS certificates, leave empty for HTTP-only)
NGINX_PORT_HTTPS=

# Path to the HTTPS server block config (set to ./nginx/nginx-https-prod.conf in prod; empty/dev-null for HTTP-only)
NGINX_HTTPS_CONF=/dev/null

# Let's Encrypt / Certbot volume directories (only used in production)
CERTBOT_CONF_DIR=./certbot/conf
CERTBOT_WWW_DIR=./certbot/www
