    {
      "id": "3a881bb3-a7fe-4d0b-adeb-afdde2e66525",
      "name": "idea-coordinator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [224, 0],
      "parameters": {
        "options": {
          "systemMessage": "You are idea-coordinator. Select the IDEA Assistant for the visitor's current message. Return exactly one assistant ID, with no other text.\n- sea: sea levels, tides, tide gauges, datums, benchmarks, coastal flooding, and sea-level analysis.\n- mars-assistant: Mars and NASA InSight, including pressure, temperature, Sol dates, imagery, and mission questions.\n- welcome-assistant: greetings, IDEA onboarding, assistant discovery, and general or unmatched questions.\nUse prior visitor messages and your prior assistant selections to resolve follow-ups. Keep the previous specialist for a follow-up about its work unless the current message changes topic. The workflow sends the visitor's original request to the selected Assistant.",
          "maxIterations": 1,
          "enableStreaming": false
        }
      }
    },
    {
      "id": "a84dcf82-7d25-40fa-9821-bb1eb0524bcc",
      "name": "Coordinator Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [192, 224],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-6-luna"
        },
        "options": {
          "maxRetries": 0
        }
      }
    },
    {
      "id": "4a26f628-e0aa-4a13-88af-d15c1f860777",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [320, 224],
      "parameters": {}
    },
    {
      "id": "753d52f5-172b-4a13-9430-54ac41fd2e38",
      "name": "Select specialist",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [448, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "12c1957d-61aa-43b6-848a-d7749761b561",
              "name": "assistant",
              "value": "={{ ['welcome-assistant', 'sea', 'mars-assistant'].includes($json.output.trim()) ? $json.output.trim() : 'welcome-assistant' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0e6e0e10-36e0-4fe7-841a-ac945891f68e",
      "name": "Answer with selected assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [672, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('When chat message received').first().json.chatInput }}",
        "options": {
          "systemMessage": "Answer the visitor as the selected IDEA Assistant. Use IDEA's conversation context and tools when needed. Return one user-facing response.",
          "maxIterations": 1,
          "enableStreaming": true
        }
      }
    },
    {
      "id": "315fb8da-d2eb-4a1f-8696-204de5947b5b",
      "name": "Specialist Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [640, 224],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Select specialist').first().json.assistant }}"
        },
        "options": {
          "maxRetries": 0
        }
      }
    },
    {
      "id": "de8b1b49-f0b4-4c94-b916-79b43b657abc",
      "name": "Specialist Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [816, 224],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ 'assistant:' + $('Select specialist').first().json.assistant + ':' + $('When chat message received').first().json.sessionId }}",
        "contextWindowLength": 4
      }
    },
    {
      "id": "54a99833-f211-44f8-93be-f556f288b1ce",
      "name": "Check specialist reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [992, 0],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst reply = items[0]?.json.output;\nif (typeof reply !== 'string' || !reply.trim()) {\n  throw new Error('IDEA returned an empty reply.');\n}\nconst failure = /(?:^|\\r?\\n)\\*\\*Error:\\*\\*[ \\t]+([^\\r\\n]+)$/.exec(reply.trimEnd());\nif (failure) {\n  throw new Error(failure[1]);\n}\nreturn items;"
      }
    }
  ],
